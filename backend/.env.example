# ── Core ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3001

# ── Database (Supabase Postgres, or Amazon RDS) ─────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_receptionist

# ── Auth (Supabase Auth issues the JWT; backend verifies it) ────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ── Redis (BullMQ background jobs: follow-ups, retention, escalation) ───
REDIS_URL=redis://localhost:6379

# ── Encryption for CrmIntegration.encryptedCredentials (AES-256-GCM) ────
CREDENTIALS_ENCRYPTION_KEY= # 32-byte base64 key, `openssl rand -base64 32`

# ── Twilio (telephony + SMS, required under both voice options) ─────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID= # for A2P 10DLC compliant sends

# ── Voice provider — Option B (default for pilot clients) ───────────────
# Per-org agent/LLM ids live in the DB (Organization.retellAgentId/
# retellLlmId), not here — RetellProvider.syncAgentConfig() creates them on
# first sync. No separate webhook secret: Retell signs webhooks with this
# same API key (see retell.provider.ts verifyWebhookSignature).
RETELL_API_KEY=

VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_WEBHOOK_SECRET=

# ── Voice provider — Option A (self-orchestrated migration path) ────────
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio

# ── Text/SMS triage model ────────────────────────────────────────────────
GEMINI_TEXT_MODEL=gemini-flash-latest

# ── Push notifications (owner/technician emergency alerts) ──────────────
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON= # stringified service-account JSON

# ── CRM adapters (per-org credentials live encrypted in CrmIntegration;
#    these are only OAuth app-level client id/secret, shared across orgs) ─
SERVICETITAN_CLIENT_ID=
SERVICETITAN_CLIENT_SECRET=
HOUSECALL_PRO_CLIENT_ID=
HOUSECALL_PRO_CLIENT_SECRET=
JOBBER_CLIENT_ID=
JOBBER_CLIENT_SECRET=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# ── Monitoring ────────────────────────────────────────────────────────────
SENTRY_DSN=
